telegram:
  # Get these from https://my.telegram.org
  app_id: 0
  app_hash: ""
  phone_number: "+1234567890"
  session_file: "session.json"

deepl:
  # Get your API key from https://www.deepl.com/pro-api
  api_key: ""
  # Use https://api-free.deepl.com for free tier
  base_url: "https://api-free.deepl.com"

channels:
  # Source channel IDs to translate (numeric IDs)
  sources:
    - 0
  # Destination group ID for translated messages
  # Set to 0 to auto-create a forum group named after the source with a flag emoji
  destination: 0
  # Rename destination group to match source name + target language flag (default: true)
  # override_group_name: false

languages:
  source_lang: "AR"
  target_lang: "FR"
